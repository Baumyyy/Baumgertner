# Copy this file to .env (for docker-compose) and to backend/.env (for
# running the backend directly with `node server.js` / `npm run dev`).
# Never commit the real .env files - they are already in .gitignore.

# ===== Database =====
# For local/direct backend runs, DB_USER/DB_PASSWORD are used as-is.
# For docker-compose, the backend service instead prefers APP_DB_USER/
# APP_DB_PASSWORD (falling back to these if unset) - see backend/db/least-privilege-role.sql
# for how to create that scoped role instead of using the postgres superuser.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=portfolio

# Only used by docker-compose (backend service + db service bootstrap).
APP_DB_USER=portfolio_app
APP_DB_PASSWORD=

# ===== Server =====
PORT=3001
# Set to "production" in production deployments - controls whether the
# session cookie gets the `secure` flag (HTTPS-only).
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===== Auth =====
# Secret used to sign session cookies. Required.
SESSION_SECRET=

# ===== GitHub OAuth (admin login) =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your own GitHub username - only this account can log into /baumi-dashboard.
GITHUB_ALLOWED_USER=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ===== Email notifications (Resend) =====
RESEND_API_KEY=
# Optional, defaults to "Portfolio <onboarding@resend.dev>" if unset.
RESEND_FROM=
NOTIFICATION_EMAIL=
