# Caddy terminates TLS and is the only service with ports published to the
# host (see docker-compose.yml) - everything else, including nginx's own
# CSP/HSTS/rate-limit headers, is unchanged behind it. Caddy provisions and
# renews the Let's Encrypt certificate for {$DOMAIN} automatically; no
# manual cert setup needed.
#
# Uses a DNS-01 challenge (proves domain ownership via a Cloudflare API
# call, not an HTTP request Cloudflare's proxy would have to forward) so
# this keeps working regardless of whether Cloudflare proxying is on or
# off for the domain - see Caddy.Dockerfile for why the plain caddy:2-alpine
# image can't do this on its own.
{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy frontend:80
}

# www answered 525 until this existed. Cloudflare has a www record pointed
# at its edge, so it accepted the request and then opened a TLS connection
# to this origin with SNI "www.<domain>" - a name no certificate here
# covered, so the handshake failed and every visitor who typed www got a
# Cloudflare error page.
#
# The DNS-01 challenge above covers subdomains as well, so this needs no
# extra setup beyond the block itself. It serves nothing: one canonical
# host, and www is a permanent redirect to it.
www.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	redir https://{$DOMAIN}{uri} permanent
}
